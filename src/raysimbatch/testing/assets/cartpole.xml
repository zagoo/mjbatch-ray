<mujoco model="cartpole">
  <option timestep="0.002"/>
  <worldbody>
    <geom name="floor" type="plane" size="4 4 .1"/>
    <body name="cart" pos="0 0 .2">
      <joint name="slider" type="slide" axis="1 0 0" range="-3 3" limited="true" damping="0.1"/>
      <geom type="box" size=".2 .1 .05" mass="1" contype="0" conaffinity="0"/>
      <body name="pole" pos="0 0 .05">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom type="capsule" fromto="0 0 0 0 0 .6" size=".02" mass=".1" contype="0" conaffinity="0"/>
        <site name="tip" pos="0 0 .6"/>
      </body>
    </body>
  </worldbody>
  <actuator><motor name="push" joint="slider" gear="1"/></actuator>
  <sensor><jointpos name="angle" joint="hinge"/><framepos name="tip_pos" objtype="site" objname="tip"/></sensor>
</mujoco>
